{
  "name": "slow-index",
  "version": "0.1.0",
  "description": "A desktop Micro Slow app for the moments before calendar events.",
  "author": "nae-lab",
  "private": true,
  "main": "electron-main.js",
  "scripts": {
    "electron": "electron .",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "check": "node --check app.js && node --check micro-slows.js && node --check electron-main.js && node --check electron-preload.js"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "name": "Slow Index",
        "executableName": "Slow Index",
        "icon": "assets/app-icon",
        "ignore": [
          "^/config\\.local\\.js$",
          "^/out($|/)",
          "^/\\.git($|/)"
        ]
      },
      "makers": [
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "win32"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "electron": "^43.1.1"
  }
}
